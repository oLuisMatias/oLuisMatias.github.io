---
// The whole home page below the header. Used by the public page (src/pages/index.astro) and by the Home Page Editor's
// preview (src/pages/admin/home-preview.astro), so the editor shows exactly what the site shows. With `edit` on, the texts
// carry data-edit="..." names and the featured section shows every box, so the preview can change them in place.
import Icon from "./Icon.astro";
import ProjectCard from "./ProjectCard.astro";
import { cvHref, md, site } from "../lib/site";
import { TEMPLATE_NAMES, TEMPLATES, slotCount, type Home, type Template } from "../lib/home";
import type { Highlight } from "../lib/highlights";

interface Project {
  id: string;
  data: { title: string; topic: string; summary: string; cover?: string; coverSpacing?: string[]; tools?: string[] };
}
interface Props {
  home: Home;
  highlights: Highlight[];
  projects: Project[];
  prints: { id: string; data: { title: string; photos: string[] } }[];
  edit?: boolean;
}
const { home, highlights, projects, prints, edit = false } = Astro.props;
const linkedin = site.linkedin;

const attr = (key: string) => (edit ? { "data-edit": key } : {});
const byId = new Map(projects.map((p) => [p.id, p]));
const chosen = home.featured.slots.map((id) => byId.get(id));
const shown = chosen.filter((p): p is Project => !!p);
const columns = TEMPLATES[home.featured.template].columns;
const card = (p: Project) => ({
  id: p.id, title: p.data.title, topic: p.data.topic, summary: p.data.summary,
  cover: p.data.cover, coverSpacing: p.data.coverSpacing, tools: p.data.tools,
});
const templatePicture = (t: Template) => {
  const { rows, columns: cols } = TEMPLATES[t];
  return { rows, cols };
};
---
<section class="wrap hero">
  <div class="hero__text">
    <p class="status"><span class="status__dot" aria-hidden="true"></span><span {...attr("status")}>{home.status}</span></p>
    {edit ? (
      <h1><span {...attr("greeting")}>{home.greeting}</span><br /><span class="hero__sub" {...attr("headline")}>{home.headline}</span></h1>
    ) : (
      <h1><span class="typed" aria-hidden="true" data-text={home.greeting}><span class="typed__ghost">{home.greeting}</span><span class="typed__text"></span><span class="typed__cursor"></span></span><span class="sr-only">{home.greeting}</span><br /><span class="hero__sub">{home.headline}</span></h1>
    )}
    <p class="hero__intro" {...attr("intro")}>{home.intro}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/projects"><Icon name="layout-grid" />View projects</a>
      <a class="btn btn--ghost" href="/cv"><Icon name="id-badge-2" />See my CV</a>
      <a class="btn btn--ghost" href={cvHref} download><Icon name="file-download" />Download PDF</a>
    </div>
  </div>
  <div class="hero__photo">
    <img src={site.photo} alt={`Portrait of ${site.name}`} width="480" height="600" />
  </div>
</section>

<section class="wrap" aria-label="Highlights">
  <dl class="stats">
    {highlights.map((h) => (
      <div class="card stat"><dt>{h.label}</dt><dd>{h.value}</dd></div>
    ))}
  </dl>
</section>

{(edit || shown.length > 0) && (
  <section class="wrap section" data-featured>
    <div class="section__head">
      <div><p class="eyebrow" {...attr("featured.eyebrow")}>{home.featured.eyebrow}</p><h2 {...attr("featured.title")}>{home.featured.title}</h2></div>
      <a class="more" href="/projects">All projects<Icon name="arrow-right" size={16} /></a>
    </div>
    {edit && (
      <div class="templates" data-templates>
        <span class="templates__label">Template</span>
        {TEMPLATE_NAMES.map((t) => {
          const { rows, cols } = templatePicture(t);
          return (
            <button type="button" class:list={["templates__pill", { "is-on": t === home.featured.template }]} data-template={t} title={`${rows} ${rows === 1 ? "row" : "rows"} of ${cols}: ${slotCount(t)} projects`}>
              <span class="templates__picture" style={`grid-template-columns: repeat(${cols}, 1fr)`}>{Array.from({ length: rows * cols }, () => <i />)}</span>
              {t}
            </button>
          );
        })}
      </div>
    )}
    <div class="featured" style={`--columns: ${columns}`} data-grid>
      {edit
        ? chosen.map((p, i) => (
            <div class="slot" data-slot={i} data-id={p?.id ?? ""}>
              {p ? <ProjectCard {...card(p)} /> : <button type="button" class="slot__empty">Choose a project</button>}
            </div>
          ))
        : shown.map((p) => <ProjectCard {...card(p)} />)}
    </div>
    {edit && (
      <div hidden data-cards>
        {projects.map((p) => (
          <template data-card={p.id}><ProjectCard {...card(p)} /></template>
        ))}
      </div>
    )}
  </section>
)}

{prints.length > 0 && (
  <section class="wrap section">
    <div class="section__head">
      <div><p class="eyebrow" {...attr("prints.eyebrow")}>{home.prints.eyebrow}</p><h2 {...attr("prints.title")}>{home.prints.title}</h2></div>
      <a class="more" href="/prints">All prints<Icon name="arrow-right" size={16} /></a>
    </div>
    <ul class="prints-strip">
      {prints.map((p) => (
        <li><a class="card" href={`/prints#${p.id}`}><img src={p.data.photos[0]} alt={p.data.title} loading="lazy" /></a></li>
      ))}
    </ul>
  </section>
)}

<section class="wrap section about">
  <div><p class="eyebrow" {...attr("about.eyebrow")}>{home.about.eyebrow}</p><h2 {...attr("about.title")}>{home.about.title}</h2></div>
  <div class="prose" set:html={md(home.about.text)} {...attr("about.text")} />
</section>

<section class="wrap section">
  <div class="card cta">
    <div>
      <h2 {...attr("cta.title")}>{home.cta.title}</h2>
      <p {...attr("cta.text")}>{home.cta.text}</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--primary" href="/contact"><Icon name="send" />Send a message</a>
      {linkedin && <a class="btn btn--ghost" href={linkedin} rel="noopener"><Icon name="brand-linkedin" />LinkedIn</a>}
    </div>
  </div>
</section>

<style>
  .hero { display: flex; flex-wrap: wrap-reverse; gap: 56px; align-items: center; padding-block: 88px 64px; }
  .hero__text { flex: 999 1 520px; min-width: 0; }
  .status { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; font-size: 14px; color: var(--text); border: 1px solid var(--line); border-radius: 999px; }
  .status__dot { width: 8px; height: 8px; border-radius: 999px; background: var(--ok); }
  .hero h1 { margin-top: 22px; font-size: clamp(36px, 5.2vw, 54px); line-height: 1.04; letter-spacing: -0.035em; font-weight: 700; }
  .hero__sub { color: var(--muted); }
  /* Typewriter: an invisible copy keeps the line's width so nothing shifts while it types. */
  .typed { position: relative; display: inline-block; }
  .typed__ghost { visibility: hidden; }
  .typed__text { position: absolute; left: 0; top: 0; white-space: nowrap; }
  .typed__cursor { position: absolute; top: 0.12em; width: 0.08em; height: 0.85em; margin-left: 0.06em; background: var(--accent); animation: blink 1s steps(1) infinite; }
  .typed.is-done .typed__cursor { opacity: 0; transition: opacity 0.4s 1.2s; animation: none; }
  @keyframes blink { 50% { opacity: 0; } }
  .hero__intro { margin-top: 20px; max-width: 560px; font-size: 17px; color: var(--text); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero__photo { flex: 1 1 260px; max-width: 340px; }
  .hero__photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 28px; background: var(--surface-2); }
  /* Each box is as wide as its text needs (so a longer name does not wrap) and the rest of the row is shared out. */
  .stats { margin: 0; display: flex; flex-wrap: wrap; gap: 12px; }
  .stat { flex: 1 1 auto; min-width: 0; padding: 20px 22px; }
  .stat dt { font-size: 13px; color: var(--muted); }
  .stat dd { margin: 6px 0 0; font-size: 17px; font-weight: 600; letter-spacing: -0.01em; }
  .featured { display: grid; grid-template-columns: repeat(var(--columns), minmax(0, 1fr)); gap: 20px; align-items: stretch; }
  .featured > :global(.project-card), .slot > :global(.project-card) { height: 100%; }
  .slot { display: grid; min-width: 0; }
  .slot__empty { min-height: 220px; border: 1.5px dashed color-mix(in srgb, var(--accent) 55%, transparent); border-radius: var(--radius); background: color-mix(in srgb, var(--accent) 6%, transparent); color: var(--accent-text); font: inherit; font-size: 15px; font-weight: 600; cursor: pointer; }
  .slot__empty:hover { background: color-mix(in srgb, var(--accent) 14%, transparent); }
  .templates { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: -8px 0 20px; }
  .templates__label { font-size: 13px; color: var(--muted); margin-right: 4px; }
  .templates__pill { display: inline-flex; align-items: center; gap: 10px; padding: 6px 14px 6px 10px; border: 0; border-radius: 999px; background: var(--chip); color: var(--text); font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; }
  .templates__pill:hover { color: var(--ink); }
  .templates__pill.is-on { background: var(--accent); color: var(--on-accent); }
  .templates__picture { display: grid; gap: 2px; width: 26px; }
  .templates__picture i { display: block; height: 7px; border-radius: 2px; background: currentColor; opacity: 0.75; }
  .prints-strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 160px), 1fr)); gap: 12px; }
  .prints-strip a { display: block; }
  .prints-strip img { aspect-ratio: 1; object-fit: cover; width: 100%; }
  .about { display: flex; flex-wrap: wrap; gap: 24px 56px; }
  .about > div:first-child { flex: 1 1 260px; }
  .about h2 { margin-top: 8px; font-size: clamp(25px, 3vw, 32px); }
  .about .prose { flex: 999 1 520px; min-width: 0; }
  .cta { padding: 44px; display: flex; flex-wrap: wrap; gap: 28px; align-items: center; justify-content: space-between; }
  .cta > div:first-child { flex: 999 1 420px; min-width: 0; }
  .cta h2 { font-size: clamp(23px, 2.8vw, 30px); }
  .cta p { margin-top: 10px; color: var(--text); font-size: 16px; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 820px) {
    .hero { padding-block: 40px 48px; gap: 28px; }
    .hero__photo { flex: 0 0 auto; width: 180px; }
    .hero__photo img { border-radius: 22px; }
    .featured { grid-template-columns: minmax(0, 1fr); }
    .cta { padding: 28px; }
  }
</style>

<script>
  // Types the greeting letter by letter, like the old site (60 ms per letter).
  const box = document.querySelector<HTMLElement>(".typed");
  const out = box?.querySelector<HTMLElement>(".typed__text");
  const cursor = box?.querySelector<HTMLElement>(".typed__cursor");
  if (box && out && cursor) {
    const text = box.dataset.text ?? "";
    const place = () => { cursor.style.left = `${out.offsetWidth}px`; };
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      out.textContent = text;
      place();
      box.classList.add("is-done");
    } else {
      let i = 0;
      const step = () => {
        out.textContent = text.slice(0, ++i);
        place();
        if (i < text.length) setTimeout(step, 60);
        else box.classList.add("is-done");
      };
      place();
      setTimeout(step, 300);
    }
  }
</script>
