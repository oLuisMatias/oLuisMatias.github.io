---
// The "Tools" and "Skills" card of a project page: labeled rows, each with one shared container of chips.
import SkillTag from "./SkillTag.astro";
import ToolIcon from "./ToolIcon.astro";
import type { Tool } from "../lib/site";

interface Props {
  tools: Tool[];
  skills: string[];
}
const { tools, skills } = Astro.props;
---
{(tools.length > 0 || skills.length > 0) && (
  <div class="card facts">
    {tools.length > 0 && (
      <div>
        <h2>Tools</h2>
        <ul class="tags">{tools.map((t) => <li class="tag">{t.icon && <ToolIcon src={t.icon} />}{t.name}</li>)}</ul>
      </div>
    )}
    {skills.length > 0 && (
      <div>
        <h2>Skills</h2>
        <ul class="tags">{skills.map((s) => <SkillTag name={s} />)}</ul>
      </div>
    )}
  </div>
)}

<style>
  .facts { padding: 2px 18px; }
  .facts > div { display: grid; grid-template-columns: 72px 1fr; gap: 10px 14px; align-items: center; padding: 9px 0; min-width: 0; }
  .facts > div + div { border-top: 1px solid var(--line); }
  .facts h2 { font-size: 14px; font-weight: 600; color: var(--muted); letter-spacing: 0; }
  @media (max-width: 560px) { .facts > div { grid-template-columns: 1fr; gap: 8px; } }
</style>
