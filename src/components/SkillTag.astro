---
// A skill label with an icon: the tool's own icon when the skill names a tool,
// otherwise a small line icon picked by keyword.
import { tools } from "../lib/site";
import { skillIconPath, toolOfSkill } from "../lib/skill-icons";
import ToolIcon from "./ToolIcon.astro";

interface Props {
  name: string;
  dashed?: boolean;
}
const { name, dashed = false } = Astro.props;
const tool = toolOfSkill(name, tools);
---
<li class:list={["tag", { "tag--skill": dashed }]}>
  {tool
    ? <ToolIcon src={tool.icon} />
    : <svg class="tag__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={skillIconPath(name)} /></svg>}
  {name}
</li>
