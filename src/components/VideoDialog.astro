---
// The project video in a popup. Any element with data-video="<YouTube id>" opens it; the player is only created
// when the popup opens, so nothing loads from YouTube until someone asks for it.
import Icon from "./Icon.astro";
---
<dialog class="video-dialog card" id="video-dialog" aria-labelledby="video-dialog-title">
  <div class="video-dialog__bar">
    <h2 id="video-dialog-title">Video</h2>
    <button class="icon-btn" type="button" id="video-dialog-close" aria-label="Close" title="Close"><Icon name="x" /></button>
  </div>
  <div class="video-dialog__stage" id="video-dialog-stage"></div>
</dialog>

<style>
  .video-dialog { width: min(1100px, calc(100vw - 32px)); padding: 0; border: 0; color: var(--ink); overflow: hidden; }
  .video-dialog::backdrop { background: rgb(5 6 8 / 0.75); }
  .video-dialog__bar { display: flex; align-items: center; gap: 10px; padding: 12px 14px 12px 22px; }
  .video-dialog__bar h2 { flex: 1; min-width: 0; font-size: 16px; font-weight: 600; letter-spacing: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .video-dialog__stage { aspect-ratio: 16 / 9; background: #000; }
  .video-dialog__stage :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
</style>

<script>
  const dialog = document.getElementById("video-dialog") as HTMLDialogElement | null;
  const stage = document.getElementById("video-dialog-stage");
  const title = document.getElementById("video-dialog-title");

  function open(id: string, name: string) {
    if (!dialog || !stage || !title) return;
    title.textContent = name || "Video";
    const frame = document.createElement("iframe");
    frame.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0`;
    frame.title = name ? `${name} video` : "Video";
    frame.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen";
    frame.setAttribute("allowfullscreen", "");
    stage.replaceChildren(frame);
    dialog.showModal();
  }

  document.addEventListener("click", (e) => {
    const trigger = (e.target as Element | null)?.closest<HTMLElement>("[data-video]");
    if (!trigger) return;
    e.preventDefault();
    open(trigger.dataset.video ?? "", trigger.dataset.videoTitle ?? "");
  });
  document.getElementById("video-dialog-close")?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
  // Closing the popup removes the player, so the video stops.
  dialog?.addEventListener("close", () => stage?.replaceChildren());
</script>
