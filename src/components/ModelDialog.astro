---
// Full-control 3D viewer in a popup. Models on the page only rotate (so the wheel scrolls the page);
// any element with data-model-expand opens this dialog, where zoom and pan are enabled.
import Icon from "./Icon.astro";
---
<dialog class="model-dialog card" id="model-dialog" aria-labelledby="model-dialog-title">
  <div class="model-dialog__bar">
    <h2 id="model-dialog-title">3D model</h2>
    <span class="model-dialog__hint">Drag to rotate · scroll or pinch to zoom · right-drag to pan</span>
    <button class="icon-btn" type="button" id="model-dialog-reset" aria-label="Reset view" title="Reset view"><Icon name="focus-centered" /></button>
    <button class="icon-btn" type="button" id="model-dialog-close" aria-label="Close" title="Close"><Icon name="x" /></button>
  </div>
  <div class="model-dialog__stage" id="model-dialog-stage"></div>
</dialog>

<style>
  .model-dialog { width: min(1200px, calc(100vw - 32px)); height: min(86vh, 900px); padding: 0; border: 0; color: var(--ink); }
  .model-dialog[open] { display: flex; flex-direction: column; }
  .model-dialog::backdrop { background: rgb(5 6 8 / 0.75); }
  .model-dialog__bar { display: flex; align-items: center; gap: 10px; padding: 12px 14px 12px 22px; }
  .model-dialog__bar h2 { font-size: 16px; font-weight: 600; letter-spacing: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .model-dialog__hint { flex: 1; min-width: 0; font-size: 13px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .model-dialog__stage { flex: 1; min-height: 0; background: var(--surface-2); }
  .model-dialog__stage :global(model-viewer) { width: 100%; height: 100%; --poster-color: transparent; }
  @media (max-width: 640px) { .model-dialog__hint { display: none; } .model-dialog__bar h2 { flex: 1; } }
</style>

<script>
  type ModelViewerEl = HTMLElement & { resetTurntableRotation?: () => void; jumpCameraToGoal?: () => void; cameraOrbit: string; cameraTarget: string; fieldOfView: string };

  const dialog = document.getElementById("model-dialog") as HTMLDialogElement | null;
  const stage = document.getElementById("model-dialog-stage");
  const title = document.getElementById("model-dialog-title");
  let viewer: ModelViewerEl | null = null;

  function open(src: string, name: string, poster: string) {
    if (!dialog || !stage || !title) return;
    title.textContent = name || "3D model";
    viewer = document.createElement("model-viewer") as ModelViewerEl;
    viewer.setAttribute("src", src);
    if (poster) viewer.setAttribute("poster", poster);
    viewer.setAttribute("alt", name ? `3D model of ${name}` : "3D model");
    viewer.setAttribute("camera-controls", "");
    viewer.setAttribute("shadow-intensity", "0.6");
    viewer.setAttribute("interaction-prompt", "none");
    stage.replaceChildren(viewer);
    dialog.showModal();
  }

  document.addEventListener("click", (e) => {
    const trigger = (e.target as Element | null)?.closest<HTMLElement>("[data-model-expand]");
    if (!trigger) return;
    e.preventDefault();
    open(trigger.dataset.modelExpand ?? "", trigger.dataset.modelTitle ?? "", trigger.dataset.modelPoster ?? "");
  });
  // The "Drag to rotate" hint disappears as soon as someone touches the model.
  document.querySelectorAll<HTMLElement>("[data-model-frame]").forEach((frame) => {
    const hide = () => frame.querySelector(".model-hint")?.classList.add("model-hint--hidden");
    frame.addEventListener("pointerdown", hide, { once: true });
  });
  // Double-clicking a model on the page also opens the full viewer.
  document.querySelectorAll<HTMLElement>("[data-model-frame]").forEach((frame) =>
    frame.addEventListener("dblclick", () => frame.querySelector<HTMLElement>("[data-model-expand]")?.click()),
  );

  document.getElementById("model-dialog-reset")?.addEventListener("click", () => {
    if (!viewer) return;
    viewer.cameraOrbit = "auto auto auto";
    viewer.cameraTarget = "auto auto auto";
    viewer.fieldOfView = "auto";
    viewer.jumpCameraToGoal?.();
  });
  document.getElementById("model-dialog-close")?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });
  dialog?.addEventListener("close", () => { stage?.replaceChildren(); viewer = null; });
</script>
