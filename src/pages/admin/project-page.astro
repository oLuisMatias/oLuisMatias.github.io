---
// The Project Page Editor of the private area. On Cloudflare, everything under /admin is protected by Cloudflare Access.
import "../../styles/global.css";
import ProjectPageEditor from "../../components/editor/ProjectPageEditor.svelte";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Project Page Editor</title>
  <link rel="icon" href="/images/favicon.png" />
  <script is:inline>
    try { if (localStorage.getItem("theme") === "light") document.documentElement.dataset.theme = "light"; } catch (e) {}
  </script>
</head>
<body style="overflow:hidden">
  <ProjectPageEditor client:only="svelte" />
</body>
</html>
