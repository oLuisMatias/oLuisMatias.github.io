---
// The editor of the CV Builder (private area). ?from=3 starts from a saved version; otherwise from the newest one.
import "../../styles/global.css";
import CvDocEditor from "../../components/editor/CvDocEditor.svelte";
import seed from "../../data/cv-document.yml?raw";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>CV Builder · New version</title>
  <link rel="icon" href="/images/favicon.png" />
  <script is:inline>
    try { if (localStorage.getItem("theme") === "light") document.documentElement.dataset.theme = "light"; } catch (e) {}
  </script>
</head>
<body style="overflow:hidden">
  <CvDocEditor client:only="svelte" seed={seed} />
</body>
</html>
