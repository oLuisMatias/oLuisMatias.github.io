---
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site, visible, md, cvHref } from "../lib/site";

const projects = await visible("projects");
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const prints = (await visible("prints")).filter((p) => p.data.photos.length).slice(0, 6);
const firstName = site.name.split(" ")[0];
const [line1, ...line2] = site.headline.split(/(?<=[,.])\s+/);
---
<Base>
  <section class="wrap hero">
    <div class="hero__text">
      <p class="status"><span class="status__dot" aria-hidden="true"></span>{site.highlights[0]?.value ? `${site.role} · ${site.highlights[0].value.split("·")[0].trim()}` : site.role}</p>
      <h1><span class="typed" aria-hidden="true" data-text={`Hi, I'm ${firstName}.`}><span class="typed__ghost">Hi, I'm {firstName}.</span><span class="typed__text"></span><span class="typed__cursor"></span></span><span class="sr-only">Hi, I'm {firstName}.</span><br /><span class="hero__sub">{line1}{line2.length ? ` ${line2.join(" ")}` : ""}</span></h1>
      <p class="hero__intro">{site.intro}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/projects"><Icon name="layout-grid" />View projects</a>
        <a class="btn btn--ghost" href="/cv"><Icon name="id-badge-2" />See my CV</a>
        <a class="btn btn--ghost" href={cvHref} download><Icon name="file-download" />Download PDF</a>
      </div>
    </div>
    <div class="hero__photo">
      <img src={site.photo} alt={`Portrait of ${site.name}`} width="480" height="600" />
    </div>
  </section>

  <section class="wrap" aria-label="Highlights">
    <dl class="stats">
      {site.highlights.map((h) => (
        <div class="card stat"><dt>{h.label}</dt><dd>{h.value}</dd></div>
      ))}
    </dl>
  </section>

  {featured.length > 0 && (
    <section class="wrap section">
      <div class="section__head">
        <div><p class="eyebrow">Featured work</p><h2>Things I've built</h2></div>
        <a class="more" href="/projects">All projects<Icon name="arrow-right" size={16} /></a>
      </div>
      <div class="grid-cards">
        {featured.map((p) => (
          <ProjectCard id={p.id} title={p.data.title} topic={p.data.topic}
            summary={p.data.summary} cover={p.data.cover} coverSpacing={p.data.coverSpacing} tools={p.data.tools} />
        ))}
      </div>
    </section>
  )}

  {prints.length > 0 && (
    <section class="wrap section">
      <div class="section__head">
        <div><p class="eyebrow">Workshop</p><h2>Latest 3D prints</h2></div>
        <a class="more" href="/prints">All prints<Icon name="arrow-right" size={16} /></a>
      </div>
      <ul class="prints-strip">
        {prints.map((p) => (
          <li><a class="card" href={`/prints#${p.id}`}><img src={p.data.photos[0]} alt={p.data.title} loading="lazy" /></a></li>
        ))}
      </ul>
    </section>
  )}

  <section class="wrap section about">
    <div><p class="eyebrow">About</p><h2>Why I build things</h2></div>
    <div class="prose" set:html={md(site.about)} />
  </section>

  <section class="wrap section">
    <div class="card cta">
      <div>
        <h2>Let's talk engineering and 3D printing.</h2>
        <p>Open to opportunities in mechanical design, collaborations or just a chat.</p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--primary" href="/contact"><Icon name="send" />Send a message</a>
        {site.linkedin && <a class="btn btn--ghost" href={site.linkedin} rel="noopener"><Icon name="brand-linkedin" />LinkedIn</a>}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { display: flex; flex-wrap: wrap-reverse; gap: 56px; align-items: center; padding-block: 88px 64px; }
  .hero__text { flex: 999 1 520px; min-width: 0; }
  .status { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px; font-size: 14px; color: var(--text); border: 1px solid var(--line); border-radius: 999px; }
  .status__dot { width: 8px; height: 8px; border-radius: 999px; background: var(--ok); }
  .hero h1 { margin-top: 22px; font-size: clamp(36px, 5.2vw, 54px); line-height: 1.04; letter-spacing: -0.035em; font-weight: 700; }
  .hero__sub { color: var(--muted); }
  /* Typewriter: an invisible copy keeps the line's width so nothing shifts while it types. */
  .typed { position: relative; display: inline-block; }
  .typed__ghost { visibility: hidden; }
  .typed__text { position: absolute; left: 0; top: 0; white-space: nowrap; }
  .typed__cursor { position: absolute; top: 0.12em; width: 0.08em; height: 0.85em; margin-left: 0.06em; background: var(--accent); animation: blink 1s steps(1) infinite; }
  .typed.is-done .typed__cursor { opacity: 0; transition: opacity 0.4s 1.2s; animation: none; }
  @keyframes blink { 50% { opacity: 0; } }
  .hero__intro { margin-top: 20px; max-width: 560px; font-size: 17px; color: var(--text); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero__photo { flex: 1 1 260px; max-width: 340px; }
  .hero__photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 28px; background: var(--surface-2); }
  .stats { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 12px; }
  .stat { padding: 20px 22px; }
  .stat dt { font-size: 13px; color: var(--muted); }
  .stat dd { margin: 6px 0 0; font-size: 17px; font-weight: 600; letter-spacing: -0.01em; }
  .prints-strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 160px), 1fr)); gap: 12px; }
  .prints-strip a { display: block; }
  .prints-strip img { aspect-ratio: 1; object-fit: cover; width: 100%; }
  .about { display: flex; flex-wrap: wrap; gap: 24px 56px; }
  .about > div:first-child { flex: 1 1 260px; }
  .about h2 { margin-top: 8px; font-size: clamp(25px, 3vw, 32px); }
  .about .prose { flex: 999 1 520px; min-width: 0; }
  .cta { padding: 44px; display: flex; flex-wrap: wrap; gap: 28px; align-items: center; justify-content: space-between; }
  .cta > div:first-child { flex: 999 1 420px; min-width: 0; }
  .cta h2 { font-size: clamp(23px, 2.8vw, 30px); }
  .cta p { margin-top: 10px; color: var(--text); font-size: 16px; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 820px) {
    .hero { padding-block: 40px 48px; gap: 28px; }
    .hero__photo { flex: 0 0 auto; width: 180px; }
    .hero__photo img { border-radius: 22px; }
    .cta { padding: 28px; }
  }
</style>

<script>
  // Types the greeting letter by letter, like the old site (60 ms per letter).
  const box = document.querySelector<HTMLElement>(".typed");
  const out = box?.querySelector<HTMLElement>(".typed__text");
  const cursor = box?.querySelector<HTMLElement>(".typed__cursor");
  if (box && out && cursor) {
    const text = box.dataset.text ?? "";
    const place = () => { cursor.style.left = `${out.offsetWidth}px`; };
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      out.textContent = text;
      place();
      box.classList.add("is-done");
    } else {
      let i = 0;
      const step = () => {
        out.textContent = text.slice(0, ++i);
        place();
        if (i < text.length) setTimeout(step, 60);
        else box.classList.add("is-done");
      };
      place();
      setTimeout(step, 300);
    }
  }
</script>
