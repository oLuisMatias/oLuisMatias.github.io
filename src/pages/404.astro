---
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
---
<Base title="Page not found">
  <section class="wrap page-head" style="padding-bottom:40px">
    <p class="eyebrow">Error 404</p>
    <h1 style="margin-top:10px">Page not found</h1>
    <p>The link may be old, or the page has moved. Try one of these instead.</p>
    <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:28px">
      <a class="btn btn--primary" href="/"><Icon name="home" />Home</a>
      <a class="btn" href="/cv"><Icon name="file-cv" />CV</a>
      <a class="btn" href="/projects"><Icon name="tool" />Projects</a>
      <a class="btn" href="/contact"><Icon name="mail" />Contact</a>
    </div>
  </section>
</Base>
