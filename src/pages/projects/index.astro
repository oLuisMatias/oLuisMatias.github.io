---
import Base from "../../layouts/Base.astro";
import ProjectsPageBody from "../../components/ProjectsPageBody.astro";
import { projectsPage, visible } from "../../lib/site";

const projects = await visible("projects");
---
<Base title="Projects" description="Machine design, 3D printing and programming projects by Luis Matias.">
  <ProjectsPageBody page={projectsPage} projects={projects} />
</Base>

<script>
  import { dateKey } from "../../lib/projects-page";

  // Topic filter, and the date order: the page opens in the order chosen in the editor; visitors can switch it.
  const topics = document.querySelectorAll<HTMLButtonElement>(".filter[data-topic]");
  const sorts = document.querySelectorAll<HTMLButtonElement>(".filter[data-sort]");
  const grid = document.getElementById("project-grid");
  const items = () => [...(grid?.children ?? [])] as HTMLElement[];

  topics.forEach((b) =>
    b.addEventListener("click", () => {
      const topic = b.dataset.topic;
      topics.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      items().forEach((it) => (it.hidden = !!topic && it.dataset.topic !== topic));
    }),
  );

  sorts.forEach((b) =>
    b.addEventListener("click", () => {
      const newest = b.dataset.sort === "newest";
      sorts.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      const keyed = items().map((el, index) => ({ el, index, key: dateKey(el.dataset.date ?? "") }));
      keyed.sort((a, c) => {
        if (a.key === null && c.key === null) return a.index - c.index;
        if (a.key === null) return 1;
        if (c.key === null) return -1;
        return (newest ? c.key - a.key : a.key - c.key) || a.index - c.index;
      });
      grid?.append(...keyed.map((k) => k.el));
    }),
  );
</script>
