---
import Icon from "../../components/Icon.astro";
import Base from "../../layouts/Base.astro";
import "../../styles/project.css";
import ModelDialog from "../../components/ModelDialog.astro";
import VideoDialog from "../../components/VideoDialog.astro";
import { visible, tools } from "../../lib/site";
import { projectFromRaw } from "../../lib/project-model";
import { leaves } from "../../lib/boxes";
import { renderProjectBody } from "../../lib/render-project";

export async function getStaticPaths() {
  const projects = await visible("projects");
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, prev: projects[i - 1] ?? null, next: projects[i + 1] ?? null },
  }));
}

const { project, prev, next } = Astro.props;
const d = project.data;
// The page is drawn by the same code as the editor's preview (src/lib/render-project.ts), so they always match.
const page = projectFromRaw(d);
const html = renderProjectBody(page, tools);
const usesModel = !!page.model || [page.main, ...page.sections].some((root) => leaves(root).some(({ leaf }) => leaf.type === "model"));
const hasVideo = !!page.youtube;
---
<Base title={d.title} description={d.summary} image={d.cover || undefined}>
  {usesModel && <script is:inline slot="head" type="module" src="https://cdn.jsdelivr.net/npm/@google/model-viewer@4.0.0/dist/model-viewer.min.js"></script>}

  <article class="wrap">
    <Fragment set:html={html} />

    {usesModel && <ModelDialog />}
    {hasVideo && <VideoDialog />}

    <nav class="pager" aria-label="More projects">
      {prev ? <a class="card" href={`/projects/${prev.id}`}><span class="muted"><Icon name="arrow-left" size={15} />Previous</span>{prev.data.title}</a> : <span></span>}
      {next ? <a class="card pager__next" href={`/projects/${next.id}`}><span class="muted">Next<Icon name="arrow-right" size={15} /></span>{next.data.title}</a> : <span></span>}
    </nav>
  </article>
</Base>
